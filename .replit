modules = ["dart-3.8", "nodejs-20"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Media Organizer"

[[workflows.workflow]]
name = "Media Organizer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd media-organizer && npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
